{
  "expo": {
    "name": "Anidex",
    "slug": "anidex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anidex.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D7263D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anidex.app",
      "permissions": [
        "CAMERA",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "L’Anidex utilise l’appareil photo pour photographier et identifier les animaux.",
          "photosPermission": "L’Anidex accède à tes photos pour identifier les animaux que tu as déjà photographiés."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "L’Anidex enregistre le lieu de tes observations pour ton journal et les badges d’exploration."
        }
      ]
    ],
    "scheme": "anidex",
    "splash": {
      "backgroundColor": "#D7263D"
    }
  }
}